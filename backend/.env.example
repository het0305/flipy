# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/authdb

# JWT Secret (generate a random string)
JWT_SECRET=yourSuperSecretKey

# Server Port
PORT=5000

# Email Configuration
# Generate Gmail App Password: https://myaccount.google.com/apppasswords
EMAIL_USER1=your-email@gmail.com
EMAIL_PASS1=your-16-character-app-password

EMAIL_USER2=your-second-email@gmail.com
EMAIL_PASS2=your-16-character-app-password

# INSTRUCTIONS:
# 1. Copy this file to .env
# 2. Replace all placeholder values with your actual credentials
# 3. NEVER commit .env to Git (it's in .gitignore)
# 4. For Gmail: Enable 2FA and generate App Passwords
# 5. Remove all spaces from app passwords
